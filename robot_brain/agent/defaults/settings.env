# Manta single-LAB deployment. PROJECT_ROOT intentionally remains /mlsteam/workspace.
APP_PORT=8000

# Qwen3.6 planner via vLLM.
PLANNER_MODEL_ID=Qwen/Qwen3.6-35B-A3B-FP8
PLANNER_SERVED_NAME=qwen3.6-planner
PLANNER_PORT=8101
PLANNER_BASE_URL=http://127.0.0.1:8101/v1
PLANNER_MAX_MODEL_LEN=32768
PLANNER_GPU_MEMORY_UTILIZATION=0.72

# BTGenBot-2 compiler via a second vLLM server.
ENABLE_BTGENBOT=1
BT_COMPILER_MODEL_ID=AIRLab-POLIMI/llama-3.2-1b-it-ft-lora-bt
BT_COMPILER_SERVED_NAME=btgenbot-2
BT_COMPILER_PORT=8102
BT_COMPILER_BASE_URL=http://127.0.0.1:8102/v1
BT_COMPILER_MAX_MODEL_LEN=8192
# Maximum generated XML tokens per compiler request. Must leave room for the prompt inside the 8192-token context.
BT_COMPILER_MAX_OUTPUT_TOKENS=500
# BTGenBot-2 official-style inference benefits from sampled generation; repair is more conservative.
BT_COMPILER_TEMPERATURE=0.7
BT_COMPILER_REPAIR_TEMPERATURE=0.2
# Compile each semantic phase independently to prevent long-form degeneration/repetition.
BT_COMPILER_PHASE_RETRIES=2
# If the small compiler cannot produce a valid nominal phase after bounded retries,
# use a deterministic action->verification skeleton and surface the fallback in diagnostics.
BT_COMPILER_DETERMINISTIC_FALLBACK=1
BT_COMPILER_GPU_MEMORY_UTILIZATION=0.12

MODEL_START_TIMEOUT_SECONDS=3600
LLM_REQUEST_TIMEOUT_SECONDS=600
MAX_IR_REPAIR_ATTEMPTS=2
MAX_BT_REPAIR_ATTEMPTS=2
ENABLE_PLAN_CRITIC=1
MAX_POLICY_ATTEMPTS=10
CORS_ORIGINS=*

# Fall back to JSON-only prompting if the running vLLM server is too old for json_schema response_format.
STRUCTURED_OUTPUT_FALLBACK=1

# Timing build: persist per-request stage/model timing traces under agent-runtime/evaluations/timing/.
TIMING_TRACE_PERSIST=1

# v5.3 planner latency controls. Thinking remains ENABLED; only its per-request
# budget is bounded so the model leaves room for the final structured answer.
PLANNER_FORCE_THINKING=1
PLANNER_THINKING_BUDGET_FALLBACK=1
PLANNER_REQUIREMENTS_THINKING_BUDGET=640
PLANNER_TASK_THINKING_BUDGET=3072
PLANNER_TASK_RETRY_THINKING_BUDGET=4096
PLANNER_TASK_THINKING_BUDGET_MEDIUM=6144
PLANNER_TASK_THINKING_BUDGET_COMPLEX=8192
PLANNER_CRITIC_THINKING_BUDGET=3072
PLANNER_REPAIR_THINKING_BUDGET=4096
PLANNER_DIRECT_THINKING_BUDGET=4096

# Keep the critic available, but run it only when the deterministic quality gate
# finds a robustness gap. Set PLAN_CRITIC_MODE=always for the old v4 behavior.
PLAN_CRITIC_MODE=conditional

# Continuous-search hardening: with the current live registry this injects Patrol
# and a finite timeout so the compiler emits
# VisualizeObject -> Timeout(ReactiveFallback(IsObjectFound, Patrol)). The degree
# setting remains only for compatibility with old/demo registries.
PLAN_AUTO_HARDEN_SEARCH_RECOVERY=1
AUTO_SEARCH_RECOVERY_DEGREES=45

# v5.4 BT-engine HTTP integration. Planning remains available even when the robot
# engine is offline unless BT_ENGINE_REQUIRED_FOR_HEALTH=1.
BT_ENGINE_ENABLED=1
# Automatically submit every successfully generated and deterministically validated
# BT to POST /execute. Set to 0 only for offline development or maintenance.
BT_ENGINE_AUTO_EXECUTE=1
BT_ENGINE_URL=https://mcpc.taile84e23.ts.net
BT_ENGINE_TOKEN=
BT_ENGINE_REQUEST_TIMEOUT_SECONDS=5
BT_ENGINE_HEALTH_TIMEOUT_SECONDS=1.5
BT_ENGINE_POLL_INTERVAL_SECONDS=0.3
BT_ENGINE_MAX_POLL_SECONDS=900
# v6.1 live BT-node synchronization. Every Agent process start/restart performs
# GET /nodes?builtin=0 synchronously before planning and rebuilds the merged Skill
# Registry + Skill RAG. New engine leaves without local semantic metadata are
# formally ingested but quarantined from Planner/RAG until the overlay is completed.
# Emergency offline-development bypass only:
BT_ENGINE_SKIP_STARTUP_NODE_SYNC=0
# Protect against accidentally replacing a valid registry with an empty/malformed
# custom-node export. Set 0 only for an intentionally leaf-less engine.
BT_ENGINE_SYNC_MIN_CUSTOM_NODES=1
# /health becomes not-ok when any live Action/Condition lacks semantic overlay.
BT_ENGINE_SEMANTIC_COMPLETE_FOR_HEALTH=1
BT_ENGINE_REQUIRED_FOR_HEALTH=0

# v5.5 fast-first compact semantic planner. Qwen thinking remains ON. The compact
# path emits only semantic targets + ordered actions; deterministic code expands it
# into the full TaskPlanIR. Any validation/grounding failure escalates to the existing
# 3072-token full planner rather than silently accepting a weaker plan.
COMPACT_PLANNER_ENABLED=1
COMPACT_PLANNER_THINKING_BUDGET=1280
COMPACT_PLANNER_RETRY_THINKING_BUDGET=3072
COMPACT_PLANNER_MAX_CAPABILITIES=8

# v6 memory-grounded RAG. Retrieval is local SQLite FTS5 so it adds millisecond-scale
# latency and does not introduce another model call. The existing requirement call
# also emits the retrieval sketch; the compact planner consumes only retrieved skill
# contracts plus a small amount of procedural/scene/experience context.
RAG_ENABLED=1
RAG_REQUIRED=1
RAG_SKILL_MAX_DOCS=8
RAG_PATTERN_ENABLED=1
RAG_PATTERN_MAX_DOCS=2
RAG_SCENE_ENABLED=1
RAG_SCENE_MAX_DOCS=2
RAG_EXPERIENCE_ENABLED=1
RAG_EXPERIENCE_MAX_DOCS=2
RAG_PROMPT_MAX_CHARS=10000
# Defaults to /mlsteam/workspace/agent-runtime/rag-knowledge.
# RAG_KNOWLEDGE_ROOT=/mlsteam/workspace/agent-runtime/rag-knowledge

# v6.2 deterministic scene/location grounding. Calibrated RAG locations are resolved
# against active location-navigation skills before planning. If ROBOT_MAP_VERSION is
# set, mismatched stored map versions are rejected. Set strict map-version checking to
# 1 only when your runtime always reports/configures the active map version.
LOCATION_GROUNDING_ENABLED=1
LOCATION_REQUIRE_CALIBRATED=1
LOCATION_REQUIRE_ACTIVE_MAP_VERSION=0
ROBOT_MAP_VERSION=
LOCATION_REWRITE_VISUAL_PREAMBLE=1

# v6.3 typed RAG. Location is an independent knowledge type; Scene RAG provides
# contextual/search priors. Scene retrieval fans queries out before filtering so a
# named/target-specific prior is not diluted by unrelated terms.
RAG_LOCATION_ENABLED=1
RAG_LOCATION_MAX_DOCS=4
RAG_SCENE_OVERFETCH_FACTOR=4
RAG_SEARCH_PRIOR_MIN_CONFIDENCE=0.70

# v6.3 environment trust mode.
# integration: treat configured RAG locations as executable for pipeline testing even
# if calibrated=false or map_version cannot yet be verified. Telemetry preserves those
# warnings. validated: require real calibration/map checks before coordinate execution.
LOCATION_KNOWLEDGE_MODE=integration
