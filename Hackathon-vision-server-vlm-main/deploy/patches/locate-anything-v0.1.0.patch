+// softmax(logits)[t], numerically stable; used for the optional per-token probabilities.
+static float token_prob(const std::vector<float>& logits, int t){
+    float m = -INFINITY;
+    for(float v: logits) m = std::max(m, v);
+    double sum = 0.0;
+    for(float v: logits) sum += std::exp((double)v - m);
+    return (float)(std::exp((double)logits[t] - m) / sum);
+}
