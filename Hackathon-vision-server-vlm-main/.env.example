# Copy to .env on the deploy host. .env is gitignored and survives deploys.

# Folder holding locate-anything-q8_0.gguf (and sam2.1_hiera_tiny.pt for mask mode).
# Hackathon-local-server: /home/wildbot/Documents/vlm
LOCATE_MODELS_DIR=/home/wildbot/Documents/vlm

# Locate decoding mode: fast (default, ~1.9 s on 640x362) | hybrid | slow.
# Use hybrid when many same-class objects can be in frame; clients then need timeout_s 12.0.
# LA_MODE=fast

# Strict matching (TODO.md section 3). Defaults keep the original behaviour; pick values with scripts/eval_locate.py.
# Prompt template: detect (default) | ground_multi | ground_single | region | custom string containing {q}
# LA_PROMPT_TEMPLATE=detect
# System prompt override (patched build only); unset = "You are a helpful assistant."
# LA_SYSTEM_PROMPT="..."
# Drop boxes whose confidence is below this (patched build only); 0 = keep every box.
# VLM_MIN_SCORE=0
# Which confidence to use: p_object (1 - P(<none>), the only one that separates right from wrong
# in the 2026-09-20 eval) | p_coord (mean of the 4 coordinate tokens) | p_start (the <box> token, ~1 always)
# VLM_SCORE_FIELD=p_object

# 1 = also run SAM2 and attach a mask PNG (~0.6 s extra per request).
# VLM_RETURN_MASK=0

# Description loaded at startup, so a restart does not leave the server in NO_QUERY.
# VLM_INITIAL_QUERY="the white paper cup"
