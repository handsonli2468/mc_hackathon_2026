# Copy to .env and fill in. .env is git-ignored: keep tokens there only.

# ---- BT engine (mc_main_nav) ----
# Same host as the gateway: http://localhost:8090   public: https://mcpc.taile84e23.ts.net
BT_ENGINE_URL=http://localhost:8090
BT_ENGINE_TOKEN=

# ---- Cloud task server (Manta, see APP_API.md) ----
# http = Manta at CLOUD_URL; mock = offline stand-in (logs to data/*.jsonl)
CLOUD_MODE=http
CLOUD_URL=http://210.61.209.139:45343
CLOUD_TOKEN=
# CLOUD_PIPELINE_MODE=hybrid
# CLOUD_CHAT_TIMEOUT_S=240
# Mock only: a planned demo tree is sent to bt_engine (like Manta auto-execution). THIS MOVES THE REAL ROBOT.
MOCK_EXECUTE=false
# MOCK_TREE_FILE=/path/to/tree.xml

# ---- Calibration (compose.yaml sets these for the container; only for local dev) ----
# CALIB_MODE=auto            # auto | ros | mock
# FIELD_FILE=./data/field_app.yaml
# CALIB_OUTPUT_DIR=./data/calib_out

# ---- ROS (must match the localization server's container) ----
ROS_DOMAIN_ID=59

# ---- docker compose ----
# Localization repo on this host (relative to this folder, or absolute)
# VISION_WS=../Hackathon-vision-server-localization
# APP_PORT=8000
