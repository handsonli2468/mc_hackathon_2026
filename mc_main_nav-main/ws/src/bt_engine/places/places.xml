<?xml version="1.0"?>
<!--
  Named places on the field, packaged so a generated tree can just call them:

      <SubTree ID="GoHome" name="go_home"/>

  These subtrees are registered into the engine's factory at start-up, so a tree does NOT
  need to define them - only to call them. Coordinates live here and nowhere else; see
  docs/map_places.md for the layout and the margins it respects.

  Field 1.80 x 1.2 m, origin bottom-left, 0 deg = +X. Robot radius 0.15 m, so every point
  below keeps the robot centre at least 0.30 m from a wall.
-->
<root BTCPP_format="4">

  <!-- HOME (0.30, 0.30): where the robot starts and parks, facing into the field. -->
  <BehaviorTree ID="GoHome">
    <NavigateToPoint name="go_home" x="0.30" y="0.30" yaw_deg="0" speed="normal"/>
  </BehaviorTree>

  <!-- STORAGE (1.50, 0.30): drop-off, diagonally opposite HOME. Slow: it is carrying. -->
  <BehaviorTree ID="GoToStorage">
    <NavigateToPoint name="go_to_storage" x="1.50" y="0.30" yaw_deg="0" speed="slow"/>
  </BehaviorTree>

  <!-- CENTRE (0.90, 0.60): the middle of the field, and of the patrol box. -->
  <BehaviorTree ID="GoToCentre">
    <NavigateToPoint name="go_to_centre" x="0.90" y="0.60" speed="normal"/>
  </BehaviorTree>

  <!-- Drive to the centre and turn on the spot for ever: sees the corners a patrol lap
       never reaches. Never succeeds on its own - put it under a Timeout or a
       ReactiveFallback that can stop it. -->
  <BehaviorTree ID="ScanFromCentre">
    <Sequence name="centre_then_spin">
      <SubTree ID="GoToCentre" name="to_centre"/>
      <Repeat name="keep_turning" num_cycles="-1">
        <RotateInPlace name="turn_45" angle_deg="45"/>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- The four quadrant vantage posts. -->
  <BehaviorTree ID="GoToVantageNW">
    <NavigateToPoint name="go_to_vantage_nw" x="0.45" y="0.90" speed="normal"/>
  </BehaviorTree>
  <BehaviorTree ID="GoToVantageNE">
    <NavigateToPoint name="go_to_vantage_ne" x="1.35" y="0.90" speed="normal"/>
  </BehaviorTree>
  <BehaviorTree ID="GoToVantageSE">
    <NavigateToPoint name="go_to_vantage_se" x="1.35" y="0.30" speed="normal"/>
  </BehaviorTree>
  <BehaviorTree ID="GoToVantageSW">
    <NavigateToPoint name="go_to_vantage_sw" x="0.45" y="0.30" speed="normal"/>
  </BehaviorTree>

  <!-- One lap of the four vantage posts, for a search that wants coverage rather than
       a tight patrol. Succeeds when the lap finishes. -->
  <BehaviorTree ID="TourTheCorners">
    <Sequence name="tour_the_corners">
      <SubTree ID="GoToVantageNW" name="corner_nw"/>
      <SubTree ID="GoToVantageNE" name="corner_ne"/>
      <SubTree ID="GoToVantageSE" name="corner_se"/>
      <SubTree ID="GoToVantageSW" name="corner_sw"/>
    </Sequence>
  </BehaviorTree>

</root>
