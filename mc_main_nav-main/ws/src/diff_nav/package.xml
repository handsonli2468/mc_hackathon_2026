<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diff_nav</name>
  <version>0.1.0</version>
  <description>Object-level navigation on top of Nav2 for a table-top differential-drive robot (Raspberry Pi), plus a kinematic simulator.</description>
  <maintainer email="chuangtsh0526@gmail.com">kesler</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- rviz2 / nav2_rviz_plugins are only needed for launch/rviz.launch.py on a PC;
       not listed so rosdep doesn't pull a GUI onto the robot Pi. -->
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
